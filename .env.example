# ================================
# Telegram Bot
# ================================
BOT_TOKEN=your_bot_token_here
ADMIN_TG_IDS=123456789,987654321   # Telegram ID модераторов (через запятую)

# ================================
# PostgreSQL
# ================================
POSTGRES_USER=studmatch
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=studmatch
DATABASE_URL=postgresql+asyncpg://studmatch:strongpassword@postgres:5432/studmatch

# ================================
# Redis
# ================================
REDIS_URL=redis://redis:6379/0

# ================================
# MinIO (документы, дипломы)
# ================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_PUBLIC=public
MINIO_SECURE=false

# ================================
# SMTP (Яндекс Почта / Яндекс 360)
# ================================
# Как получить пароль приложения: https://id.yandex.ru/security -> Пароли приложений -> Почта
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=studmatch@yandex.ru
SMTP_PASSWORD=your_yandex_app_password
SMTP_FROM=СтудМэч <studmatch@yandex.ru>
SMTP_USE_SSL=true

# ================================
# ЮКасса
# ================================
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=https://yourdomain.com/payment/success

# ================================
# Web / FastAPI
# ================================
SECRET_KEY=change_this_to_random_secret_64chars
WEB_HOST=0.0.0.0
WEB_PORT=8000
DOMAIN=https://yourdomain.com

# ================================
# Суперлайки — цены (руб)
# ================================
PRICE_SUPERLIKE_3=99
PRICE_SUPERLIKE_10=249
PRICE_BOOST_24H=149
